# Copy to .env.local and fill in. Never commit real keys.

# Meta Model API (leave empty to run everything in mock mode)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3

# Optional: narrate with an open-weight Meta model on a partner (e.g. Baseten)
# GUIDE_MODEL_BACKEND=open
# OPEN_MODEL_BASE_URL=
# OPEN_MODEL_API_KEY=
# OPEN_MODEL_NAME=meta-models/muse-spark-open-1026

# Text-to-speech: none | azure | elevenlabs  (none = browser speechSynthesis)
TTS_PROVIDER=none
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Cost guard for the public demo URL
DAILY_REQUEST_LIMIT=2000
